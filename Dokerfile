FROM php:8.2-apache

# Installer les dépendances système
RUN apt-get update && apt-get install -y \
    git unzip zip curl libicu-dev libonig-dev libxml2-dev libzip-dev \
    && docker-php-ext-install intl pdo pdo_mysql zip

# Installer Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copier le code
COPY . /var/www/html/

# Déplacer les fichiers Symfony dans le bon dossier
WORKDIR /var/www/html

# Installer les dépendances PHP
RUN composer install --no-dev --optimize-autoloader

# Donner les droits nécessaires à Apache
RUN chown -R www-data:www-data /var/www/html/var /var/www/html/vendor

# Activer le module Apache rewrite (important pour Symfony)
RUN a2enmod rewrite
