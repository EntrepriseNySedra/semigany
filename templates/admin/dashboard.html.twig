<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Administrateur - SEMIGANY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="#">SEMIGANY Admin</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Déconnexion</a></li>
            </ul>
        </div>
    </div>
</nav>

<div class="container my-4">

    <!-- Statistiques globales -->
    <div class="row mb-4">
        <div class="col-md-3"><div class="card text-white bg-success mb-3"><div class="card-body"><h5>Membres</h5><p class="fs-4">128</p></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-info mb-3"><div class="card-body"><h5>Événements</h5><p class="fs-4">5 actifs</p></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-warning mb-3"><div class="card-body"><h5>Réservations</h5><p class="fs-4">142</p></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-danger mb-3"><div class="card-body"><h5>Cotisations</h5><p class="fs-4">80% réglées</p></div></div></div>
    </div>

    <!-- Membres -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">Gestion des membres</div>
        <div class="card-body">
            <div class="mb-3">
                <input type="text" class="form-control" placeholder="Rechercher un membre...">
            </div>
            <table class="table table-striped">
                <thead><tr><th>Nom</th><th>Email</th><th>Promotion</th><th>Actions</th></tr></thead>
                <tbody>
                    <tr>
                        <td>Rakoto Jean</td><td>jean@example.com</td><td>2022</td>
                        <td>
                            <button class="btn btn-sm btn-warning">Éditer</button>
                            <button class="btn btn-sm btn-info">Cotisation</button>
                        </td>
                    </tr>
                </tbody>
            </table>
            <button class="btn btn-success">Exporter CSV</button>
        </div>
    </div>

    <!-- Événements -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">Créer un événement</div>
        <div class="card-body">
            <form>
                <div class="row g-3">
                    <div class="col-md-4"><input type="text" class="form-control" placeholder="Titre de l’événement"></div>
                    <div class="col-md-2"><input type="number" class="form-control" placeholder="Places dispo"></div>
                    <div class="col-md-2"><select class="form-select"><option>Gratuit</option><option>Payant</option></select></div>
                    <div class="col-md-2"><select class="form-select"><option>Public</option><option>Membres</option></select></div>
                    <div class="col-md-2"><input type="date" class="form-control"></div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary">Créer</button>
                    <button class="btn btn-danger">Désactiver la vente</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Candidatures -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">Candidatures internes</div>
        <div class="card-body">
            <p>Ajouter ou gérer les candidatures aux élections du comité.</p>
            <button class="btn btn-outline-primary">Ajouter une candidature</button>
        </div>
    </div>

    <!-- Paiements & QR -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">Suivi paiements & QR Codes</div>
        <div class="card-body">
            <p>Suivi en temps réel des paiements des membres et génération automatique de QR Codes.</p>
            <button class="btn btn-success">Voir les paiements</button>
            <button class="btn btn-secondary">Générer QR Codes</button>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
