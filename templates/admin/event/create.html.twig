<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Gestion des membres - SEMIGANY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="#">SEMIGANY Admin</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a></li>
            </ul>
        </div>
    </div>
</nav>
<div class="container py-4">
    <h1 class="mb-4 text-center">Ajouter un nouvel événement</h1>

    <!-- Début du formulaire -->
    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    
    <div class="row mb-3">
        <div class="col-md-6">
            {{ form_row(form.titre, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            {{ form_row(form.dateFin, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.nb_places, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            {{ form_row(form.tarif, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            {{ form_row(form.visible_pour, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            {{ form_row(form.date_limite, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12 text-center">
            <button type="submit" class="btn btn-success btn-lg">Créer l'événement</button>
        </div>
    </div>
    
    <!-- Fin du formulaire -->
    {{ form_end(form) }}
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
// Fonction de recherche en direct
document.getElementById("searchInput").addEventListener("keyup", function () {
    let filter = this.value.toLowerCase();
    let rows = document.querySelectorAll("tbody tr");

    rows.forEach(row => {
        let text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? "" : "none";
    });
});

// Fonction d'exportation CSV
function exportTableToCSV() {
    let csv = [];
    let rows = document.querySelectorAll("table tr");

    rows.forEach(row => {
        let cols = Array.from(row.querySelectorAll("td, th")).map(cell => `"${cell.innerText}"`);
        csv.push(cols.join(","));
    });

    let csvBlob = new Blob([csv.join("\n")], { type: "text/csv" });
    let link = document.createElement("a");
    link.href = URL.createObjectURL(csvBlob);
    link.download = "membres.csv";
    link.click();
}
</script>

</body>
</html>
