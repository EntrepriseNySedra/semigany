<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Ajouter un nouvel événement - SEMIGANY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .form-container {
            background-color: #f8f9fa;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        }
        .form-container h1 {
            margin-bottom: 20px;
            font-size: 1.5rem;
            color: #495057;
        }
        .btn-success {
            width: 100%;
            padding: 10px;
            font-size: 1.1rem;
            border-radius: 5px;
        }
        .navbar {
            margin-bottom: 30px;
        }
    </style>
</head>
<body>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="#">SEMIGANY Admin</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Déconnexion</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Container principal -->
<div class="container py-4">
    <div class="form-container">
        <h1 class="mb-4 text-center">Ajouter un nouvel événement</h1>

        <!-- Début du formulaire -->
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
        
        <div class="row mb-3">
            <div class="col-md-6">
                {{ form_row(form.titre, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                {{ form_row(form.dateFin, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.nb_places, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                {{ form_row(form.tarif, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                {{ form_row(form.visible_pour, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                {{ form_row(form.date_limite, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-12 text-center">
                <button type="submit" class="btn btn-success btn-lg">Créer l'événement</button>
            </div>
        </div>
        
        <!-- Fin du formulaire -->
        {{ form_end(form) }}
    </div>
</div>

<!-- JavaScript nécessaire -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
