
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Gestion des membres - SEMIGANY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="#">SEMIGANY Admin</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Déconnexion</a></li>
            </ul>
        </div>
    </div>
</nav>
<div class="container py-4">
    <h1>Liste des événements</h1>

    <a href="{{ path('admin_event_create') }}" class="btn btn-primary">Ajouter un événement</a>

    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Description</th>
                <th>Date début</th>
                <th>Date fin</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
                <tr>
                    <td>{{ event.titre }}</td>
                    <td>{{ event.description }}</td>
                    <td>{{ event.dateDebut|date('d/m/Y') }}</td>
                    <td>{{ event.dateFin|date('d/m/Y') }}</td>
                    <td>
                        <a href="{{ path('admin_event_edit', {'id': event.id}) }}" class="btn btn-warning">Modifier</a>
                        <a href="{{ path('admin_event_delete', {'id': event.id}) }}" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?')">Supprimer</a>
                        <a href="{{ path('admin_event_reservations', {'id': event.id}) }}" class="btn btn-info">Réservations</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

     <!-- Boutons -->
    <div class="d-flex justify-content-between mt-3">
        <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">⬅ Retour</a>
    </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</div>
<script>
// Fonction de recherche en direct
document.getElementById("searchInput").addEventListener("keyup", function () {
    let filter = this.value.toLowerCase();
    let rows = document.querySelectorAll("tbody tr");

    rows.forEach(row => {
        let text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? "" : "none";
    });
});

// Fonction d'exportation CSV
function exportTableToCSV() {
    let csv = [];
    let rows = document.querySelectorAll("table tr");

    rows.forEach(row => {
        let cols = Array.from(row.querySelectorAll("td, th")).map(cell => `"${cell.innerText}"`);
        csv.push(cols.join(","));
    });

    let csvBlob = new Blob([csv.join("\n")], { type: "text/csv" });
    let link = document.createElement("a");
    link.href = URL.createObjectURL(csvBlob);
    link.download = "membres.csv";
    link.click();
}
</script>

</body>
</html>
