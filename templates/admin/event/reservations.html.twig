<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Gestion des membres - SEMIGANY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<style>
    th, td {
        vertical-align: middle;
        text-align: center;
    }

    .form-check-input {
        transform: scale(1.2);
    }

    @media (max-width: 576px) {
        h3 {
            font-size: 1.3rem;
        }
        .btn {
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>
<body>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="#">SEMIGANY Admin</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Déconnexion</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Container -->
<div class="container py-4">

<h3 class="mt-4">Réservations pour l’événement : {{ event.titre }}</h3>
<div class="card border-info mb-4">
    <div class="card-body text-info">
        <h4 class="mt-3">
            Réservations ({{ totalPlacesReservées }} / {{ event.nbPlaces }} places occupées)
        </h4>
    </div>
</div>


<form method="post">
    <table class="table table-bordered table-hover mt-3">
        <thead class="table-light">
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Nombre de places</th>
                <th>Statut</th>
                <th>Valider</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.nom }} {{ reservation.prenom }}</td>
                    <td>{{ reservation.email }}</td>
                    <td>{{ reservation.totalPlaces }}</td>
                    <td>{{ reservation.statut }}</td>
                    <td>
                        <input type="checkbox" name="validate[]" value="{{ reservation.userId }}">
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center">Aucune réservation trouvée pour cet événement.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <button type="submit" class="btn btn-success mt-2">Valider les réservations</button>
</form>


<a href="{{ path('admin_dashboard') }}" class="btn btn-secondary mt-3">← Retour</a>


</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
// Fonction de recherche en direct
document.getElementById("searchInput").addEventListener("keyup", function () {
    let filter = this.value.toLowerCase();
    let rows = document.querySelectorAll("tbody tr");

    rows.forEach(row => {
        let text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? "" : "none";
    });
});

// Fonction d'exportation CSV
function exportTableToCSV() {
    let csv = [];
    let rows = document.querySelectorAll("table tr");

    rows.forEach(row => {
        let cols = Array.from(row.querySelectorAll("td, th")).map(cell => `"${cell.innerText}"`);
        csv.push(cols.join(","));
    });

    let csvBlob = new Blob([csv.join("\n")], { type: "text/csv" });
    let link = document.createElement("a");
    link.href = URL.createObjectURL(csvBlob);
    link.download = "membres.csv";
    link.click();
}
</script>

</body>
</html>