<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Tableau de bord - Admin SEMIGANY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="#">SEMIGANY Admin</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a></li>
            </ul>
        </div>
    </div>
</nav>



<div class="container py-4">
    <h2 class="mb-4">Tableau de bord</h2>

     <!-- Statistiques globales -->
    <div class="row mb-4">
        <div class="col-md-3"><div class="card text-white bg-success mb-3"><div class="card-body"><h5>Membres</h5><p class="fs-4">128</p></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-info mb-3"><div class="card-body"><h5>Événements</h5><p class="fs-4">5 actifs</p></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-warning mb-3"><div class="card-body"><h5>Réservations</h5><p class="fs-4">142</p></div></div></div>
        <div class="col-md-3"><div class="card text-white bg-danger mb-3"><div class="card-body"><h5>Cotisations</h5><p class="fs-4">80% réglées</p></div></div></div>
    </div>
    <div class="row g-4">
        <!-- Membres -->
        <div class="col-md-4">
            <a href="{{ path('admin_membres') }}" class="text-decoration-none">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Gestion des membres</h5>
                        <p class="card-text">Liste, cotisations, export et édition carte</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Événements -->
        <div class="col-md-4">
            <a href="{{ path('admin_events') }}" class="text-decoration-none">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Événements</h5>
                        <p class="card-text">Création, suivi , billeteries</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Candidatures -->
        <div class="col-md-4">
            <a href="" class="text-decoration-none">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">Candidatures</h5>
                        <p class="card-text">Élections internes du comité</p>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
