<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Gestion des membres - SEMIGANY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="#">SEMIGANY Admin</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Déconnexion</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- Container -->
<div class="container py-4">
    <h2 class="mb-4">Gestion des membres</h2>

    <!-- Barre de recherche -->
    <div class="mb-3">
        <div class="input-group">
            <input type="text" id="searchInput" class="form-control" placeholder="Rechercher un membre...">
            <button class="btn btn-outline-secondary" type="button" id="searchButton">
                <i class="bi bi-search"></i> Chercher
            </button>
        </div>
    </div>

    <!-- Tableau responsive -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Promotion</th>
                    <th>Adresse</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.nom }} {{ user.prenom }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.telephone }}</td>
                        <td>{{ user.promotion }}</td>
                        <td>{{ user.adresse }}</td>
                        <td>
                            <a href="{{ path('member_edit', { id: user.id }) }}" class="btn btn-sm btn-warning">Éditer</a>
                            <a href="{{ path('admin_user_cotisations', { id: user.id }) }}" class="btn btn-sm btn-info">Cotisations</a>
                            <a href="{{ path('member_carte_pdf', { id: user.id }) }}" class="btn btn-sm btn-dark">Carte</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucun membre trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Boutons -->
    <div class="d-flex justify-content-between mt-3">
        <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">⬅ Retour</a>
        <button class="btn btn-success" onclick="exportTableToCSV()">Exporter CSV</button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
// Fonction de recherche en direct
document.getElementById("searchInput").addEventListener("keyup", function () {
    let filter = this.value.toLowerCase();
    let rows = document.querySelectorAll("tbody tr");

    rows.forEach(row => {
        let text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? "" : "none";
    });
});

// Fonction d'exportation CSV
function exportTableToCSV() {
    let csv = [];
    let rows = document.querySelectorAll("table tr");

    rows.forEach(row => {
        let cols = Array.from(row.querySelectorAll("td, th")).map(cell => `"${cell.innerText}"`);
        csv.push(cols.join(","));
    });

    let csvBlob = new Blob([csv.join("\n")], { type: "text/csv" });
    let link = document.createElement("a");
    link.href = URL.createObjectURL(csvBlob);
    link.download = "membres.csv";
    link.click();
}
</script>

</body>
</html>
