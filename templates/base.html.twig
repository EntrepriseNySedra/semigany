<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Semigany</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }
        header {
            background-color: #007bff; /* Bleu vif */
            color: white;
        }
        footer {
            background-color: #ffe066; /* Jaune clair */
            color: #333;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header class="p-3 mb-4">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
        <a href="{{ path('app_home') }}" class="d-flex align-items-center text-white text-decoration-none">
            <img src="/assets/logo.png" alt="Logo" height="40" class="me-2">
            <span class="fs-4">Semigany</span>
        </a>
        <nav>
            <ul class="nav">
                <li class="nav-item"><a href="{{ path('app_home') }}" class="nav-link text-white">Accueil</a></li>
                <li class="nav-item"><a href="{{ path('app_login') }}" class="nav-link text-white">Connexion</a></li>
                <li class="nav-item"><a href="{{ path('app_register') }}" class="nav-link text-white">Inscription</a></li>
            </ul>
        </nav>
    </div>
</header>

<main class="container">
    {% block body %}{% endblock %}
</main>

<footer class="text-center py-4 mt-5">
    <p>&copy; {{ "now"|date("Y") }} Semigany. Tous droits réservés.</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
